#!/usr/bin/env python3
"""Waybar module: AI agent usage limits, like Omarchy's agents widget.

Refreshes the records with jmpd-agents-update --limits-only (Omarchy's collectors,
vendored) and reads them from ~/.local/state/jmpd-agents/usage. Shows an icon, plus
the highest percentage once a limit passes 80%; the tooltip lists every limit and
when it resets. Clicking opens jmpd-agents-panel.
"""
import datetime as dt
import json
import os
import subprocess
from pathlib import Path

HOME = Path.home()
USAGE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "jmpd-agents" / "usage"
ICON = "\U000F06A9"  # nf-md-robot


def until(iso):
    left = dt.datetime.fromisoformat(iso) - dt.datetime.now(dt.timezone.utc)
    mins = max(0, int(left.total_seconds() // 60))
    days, mins = divmod(mins, 1440)
    hours, mins = divmod(mins, 60)
    return f"{days}d {hours}h" if days else f"{hours}h {mins:02d}m"


def records():
    subprocess.run([str(HOME / ".local/bin/jmpd-agents-update"), "--limits-only"],
                   capture_output=True, timeout=180)
    found = []
    for f in sorted(USAGE.glob("*.json")):
        try:
            r = json.loads(f.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if r.get("ready") and r.get("limits"):
            found.append(r)
    return found


def main():
    sections, percents = [], []
    for record in records():
        limits = record["limits"]
        name = record.get("name", record.get("id", ""))
        # Codex reports raw plan ids like "self_serve_business_prolite"
        tier = (record.get("tierLabel") or "").removeprefix("self_serve_")
        tier = tier.replace("_", " ").title() if "_" in tier else tier
        lines = [f"{name} · {tier}" if tier else name]
        for limit in limits:
            pct = round(limit["percent"] * 100)
            reset = f" · resets in {until(limit['resetsAt'])}" if limit.get("resetsAt") else ""
            lines.append(f"  {limit['label']}: {pct}%{reset}")
            percents.append(limit["percent"])
        sections.append("\n".join(lines))

    if not sections:
        print(json.dumps({"text": ICON, "tooltip": "No agent usage available", "class": "stale"}))
        return

    worst = max(percents)
    css = "critical" if worst >= 0.95 else "warning" if worst >= 0.8 else "normal"
    # Just the icon; the percentage only shows up once a limit gets close
    text = f"{ICON} {round(worst * 100)}%" if worst >= 0.8 else ICON
    print(json.dumps({"text": text, "tooltip": "\n\n".join(sections), "class": css}))


if __name__ == "__main__":
    main()
