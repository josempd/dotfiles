#!/bin/bash
# Screensaver, adapted from Omarchy's: random tte effects on the JMPD logo in a
# fullscreen kitty. Any key, or losing focus, quits it. Started by jmpd-screensaver-launch.

exit_screensaver() {
  hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x tte 2>/dev/null
  pkill -f -- '--class=jmpd\.screensaver' 2>/dev/null
  exit 0
}

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "jmpd.screensaver"' >/dev/null 2>&1
}

trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # black background
hyprctl keyword cursor:invisible true &>/dev/null

tty=$(tty 2>/dev/null)

while true; do
  tte -i ~/.config/hypr/screensaver.txt \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
    --random-effect --no-eol --no-restore-cursor &

  while pgrep -t "${tty#/dev/}" -x tte >/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
done
