#!/bin/bash
# Called by hypridle after 15 minutes idle (hypr/hypridle.conf). Covers every monitor that is on.
pgrep -f -- '--class=jmpd\.screensaver' >/dev/null && exit 0
pidof hyprlock >/dev/null && exit 0

# One window per monitor, sharing a class: moving focus between them isn't focus loss, any key closes all
cmd="kitty --class=jmpd.screensaver --override font_size=18 --override window_padding_width=0 -e jmpd-screensaver"
for monitor in $(hyprctl monitors -j | jq -r '.[] | select(.dpmsStatus) | .name'); do
  hyprctl dispatch "hl.dsp.exec_cmd([[$cmd]], { monitor = \"$monitor\" })" >/dev/null
done
