# Session environment, read by uwsm at login (~/.config/uwsm/env)
# Qt apps (polkit dialog, etc.) take colors and icons from qt6ct, written by jmpd-theme
export QT_QPA_PLATFORMTHEME=qt6ct
# mise shims so GUI-launched apps see the same node/python as the shell
export PATH="$HOME/.local/share/mise/shims:$PATH"
